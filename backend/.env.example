# Copy to .env and change SECRET_KEY. Never commit .env.
DATABASE_URL=sqlite:///./simmer.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# US4.3 discovery: initial configurable policy, pending product-owner review.
TRENDING_LIKE_WEIGHT=3
TRENDING_COMMENT_WEIGHT=5
TRENDING_COMPLETION_WEIGHT=4
TRENDING_WINDOW_DAYS=7
TRENDING_DECAY_HOURS=24
